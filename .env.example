# Neon PostgreSQL connection strings
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# JWT secret for signing session tokens (at least 32 characters; generate with: openssl rand -hex 32)
JWT_SECRET="replace-with-at-least-32-character-secret-key"

# Optional comma-separated list of emails allowed to sign up after the first owner account is created
KANEKI_SIGNUP_EMAILS=""

# GitHub Note Sync Configuration
# Fine-grained personal access token with "Contents: Read and write" repository permission
GITHUB_PAT="github_pat_xxx"
# GitHub username or organization owning the notes repository
GITHUB_OWNER="your-username"
# Target repository name for storing Markdown notes
GITHUB_REPO="your-notes-repo"
# Target branch (optional; defaults to the repository default branch)
GITHUB_BRANCH="main"

# AI Agent Configuration (Ollama Cloud / OpenAI-compatible)
# API key obtained from your Ollama Cloud account
OLLAMA_API_KEY="your-ollama-api-key"
# Target model supporting tool calling (e.g. gemma4:31b-cloud on Free tier, or gpt-oss:120b)
OLLAMA_MODEL="gemma4:31b-cloud"
# Ollama OpenAI-compatible base URL (optional; defaults to https://ollama.com/v1)
OLLAMA_BASE_URL="https://ollama.com/v1"
